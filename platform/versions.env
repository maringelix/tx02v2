# Versions installed by platform/install.sh (verified 2026-10-11). Update procedure:
# docs/MAINTENANCE.md. Values: KEY=VALUE, no quotes (read without executing the file).
#
# ALB Controller of Application Gateway for Containers: OCI chart on MCR
# (oci://mcr.microsoft.com/application-lb/charts/alb-controller). The chart gives its three images
# (controller, bootstrap, crds) one shared tag and cannot pin them by digest, so:
# - the harness and install.sh refuse a chart archive whose SHA256 differs from the one below;
# - install.sh refuses running pods whose image digests differ from the ones below.
ALB_CONTROLLER_CHART_VERSION=1.12.2
ALB_CONTROLLER_CHART_SHA256=f4f741d03f9823a06f921a05eb29f0172edfb30ef6a3f4b7260fcc4f328bd027
# Image digests of 1.12.2: the multi-arch index and its linux/amd64 manifest (the lab nodes are
# amd64; a node reports one or the other as imageID, install.sh accepts both).
ALB_CONTROLLER_IMAGE_SHA256=6991e4273bb44db26bde94b5c1717859fc44946f0e26b157736f5e9110c44b70
ALB_CONTROLLER_IMAGE_AMD64_SHA256=b6c693d57fb29434f99bb8dff1a1e3785fd82e8d4938dcf95e4aadb13c3ccad0
ALB_CONTROLLER_BOOTSTRAP_IMAGE_SHA256=0709f9fd5bfd4dff87c981541f644feb1af4e2ff2d8eb7f9e5158081938d4872
ALB_CONTROLLER_BOOTSTRAP_IMAGE_AMD64_SHA256=bf306f5d34f9642c337525d1d68621f9cb9305ec31030dd4ee8e64eabcc49166
ALB_CONTROLLER_CRDS_IMAGE_SHA256=f5e1761155222b58802865cdf3746a915eeb798890ce931e28576684e1032f06
ALB_CONTROLLER_CRDS_IMAGE_AMD64_SHA256=29198788c6b701353e30480057557e16962693c269baf58ee912eeda01ff0dca
# External Secrets Operator (charts.external-secrets.io), app v2.12.0, CRDs served as
# external-secrets.io/v1 (same release and image digest as tx01v2).
ESO_CHART_VERSION=2.12.0
# OpenTelemetry Collector (open-telemetry.github.io/opentelemetry-helm-charts), Collector contrib
# 0.162.0 (verified 2026-10-14). The local lab installs the same chart; install.sh, the harness and
# the local lab refuse an archive with another SHA256.
OTEL_COLLECTOR_CHART_VERSION=0.176.0
OTEL_COLLECTOR_CHART_SHA256=8d3f0c6efd2ae33a8c843b189b86d9f93f52422bccbb5be35c5ac24154e24868
# Kyverno 3.8.2 (controller v1.18.2), full profile only: verifies promotion attestations at admission.
KYVERNO_REPO=https://kyverno.github.io/kyverno
KYVERNO_VERSION=3.8.2
KYVERNO_SHA256=f4fc787cf1d6781eefb9e9b45837edcddcfae984c872888289914e97207cc5de
